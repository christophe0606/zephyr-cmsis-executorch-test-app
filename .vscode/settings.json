    "cmsis-csolution.environmentVariables": {
        "ZEPHYR_BASE": "$HOME/benchresults/zephyr-repo/zephyr",
        "VIRTUAL_ENV": "$HOME/benchresults/zephyr-repo/.venv/Scripts",
